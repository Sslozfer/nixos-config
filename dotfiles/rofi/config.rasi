configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    display-window:             "";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

@theme "ib"
@import "stylix.rasi"

// theme image (image height is set via y-padding)
inputbar {
    background-image:            url("images/flowers.jpg", width);
    padding:                     75px 60px;
}

